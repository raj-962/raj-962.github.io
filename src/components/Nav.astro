---
const path = Astro.url.pathname;
const items = [
  ['/', 'Home'], ['/work/', 'Work'], ['/frames/', 'Frames'],
  ['/notes/', 'Notes'], ['/story/', 'Story'], ['/contact/', 'Contact'],
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="nav-shell">
  <nav class="glass nav" aria-label="Main" id="nav">
    <a class="logo sig" href="/" aria-label="Raja Shekar, home">RS</a>
    <ul id="nav-list">
      {items.map(([h, l]) => (
        <li><a href={h} aria-current={active(h) ? 'page' : undefined}>{l}</a></li>
      ))}
    </ul>
    <button class="knob" id="theme-toggle" type="button" aria-label="Switch between dark and light theme" aria-pressed="false">
      <span class="knob-dot"></span>
    </button>
    <button class="menu" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav-list">Menu</button>
  </nav>
</header>
<style>
  .nav-shell{position:fixed;top:14px;left:0;right:0;z-index:50;display:flex;justify-content:center;padding:0 14px;pointer-events:none}
  .nav{pointer-events:auto;display:flex;align-items:center;gap:18px;padding:8px 12px 8px 18px;border-radius:999px;position:relative}
  .logo{font-size:1.6rem;text-decoration:none;line-height:1}
  ul{display:flex;gap:4px;list-style:none;margin:0;padding:0}
  li a{display:block;padding:.45rem .9rem;border-radius:999px;text-decoration:none;font-size:.95rem;color:var(--muted)}
  li a:hover{color:var(--text)}
  li a[aria-current]{color:var(--accent-ink);background:var(--accent)}
  .knob{width:46px;height:26px;flex:none;border-radius:999px;border:1px solid var(--edge);background:linear-gradient(#1b1e24,#383d48);position:relative;cursor:pointer;box-shadow:inset 0 2px 4px rgba(0,0,0,.5)}
  .knob-dot{position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,#aab2bd);box-shadow:0 2px 4px rgba(0,0,0,.5);transition:transform .2s}
  :global([data-theme="light"]) .knob{background:linear-gradient(#c9d0d8,#e3e7ec)}
  :global([data-theme="light"]) .knob-dot{transform:translateX(20px)}
  .menu{display:none}
  @media (max-width:760px){
    .nav-shell{top:10px}
    .nav{width:100%;justify-content:space-between;border-radius:22px;padding:8px 10px 8px 16px}
    .menu{display:inline-block;margin-left:auto;font:600 .9rem 'Inter Variable',sans-serif;color:var(--text);background:transparent;border:1px solid var(--edge);border-radius:999px;padding:.4rem .9rem;cursor:pointer}
    ul{display:none;position:absolute;top:calc(100% + 8px);left:0;right:0;flex-direction:column;gap:2px;padding:10px;border-radius:20px;background:var(--base);border:1px solid var(--edge);box-shadow:var(--shadow)}
    :global(#nav[data-open]) ul{display:flex}
    li a{padding:.85rem 1rem;font-size:1.05rem;border-radius:12px}
  }
</style>
<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const sync = () => btn?.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
  const nav = document.getElementById('nav')!;
  const menu = document.getElementById('menu-btn')!;
  const setOpen = (o: boolean) => {
    o ? nav.setAttribute('data-open', '') : nav.removeAttribute('data-open');
    menu.setAttribute('aria-expanded', String(o));
    menu.textContent = o ? 'Close' : 'Menu';
  };
  menu.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setOpen(false); });
</script>
