---
import Base from '../layouts/Base.astro';
import settings from '../content/data/settings.json';
---
<Base title="Contact" description="Get in touch with Raja Shekar.">
  <div class="wrap page">
    <div class="page-head"><p class="eyebrow">Contact</p><h1 class="sig">Say hello</h1>
      <p class="lede">Open to internships in VLSI, verification and embedded. I usually reply within a couple of days.</p></div>
    <div class="grid">
      <div class="glass card"><p class="eyebrow">Email</p><h3 id="mailtext">Show email address</h3>
        <p class="muted">Best for internships and project questions.</p>
        <p><a class="btn" id="mail" href="#" data-u={settings.email_user} data-d={settings.email_domain}>Send an email</a></p></div>
      <a class="glass card" href={settings.github} rel="noopener"><p class="eyebrow">GitHub</p><h3>raj-962</h3>
        <p class="muted">Code for the processor, verification and C projects.</p><span class="more">Open GitHub →</span></a>
      {settings.linkedin && <a class="glass card" href={settings.linkedin} rel="noopener"><p class="eyebrow">LinkedIn</p><h3>Connect</h3><span class="more">Open LinkedIn →</span></a>}
      <div class="glass card"><p class="eyebrow">Based in</p><h3>{settings.location}</h3><p class="muted">Happy to meet for a photo walk or a game of chess.</p></div>
    </div>
    {settings.web3forms_key && (
      <form class="form" action="https://api.web3forms.com/submit" method="POST" style="margin-top:34px">
        <input type="hidden" name="access_key" value={settings.web3forms_key} />
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true" />
        <button class="btn" type="submit">Send</button>
      </form>
    )}
  </div>
</Base>
<script>
  const a = document.getElementById('mail') as HTMLAnchorElement;
  const addr = `${a.dataset.u}@${a.dataset.d}`;
  a.href = `mailto:${addr}`;
  document.getElementById('mailtext')!.textContent = addr;
</script>
