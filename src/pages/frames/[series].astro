---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import SeriesTabs from '../../components/SeriesTabs.astro';
export async function getStaticPaths() {
  const all = await getCollection('frames');
  return (await getCollection('series')).map((s) => ({
    params: { series: s.id },
    props: { s, frames: all.filter((f) => f.data.series === s.id).sort((a, b) => +b.data.date - +a.data.date) },
  }));
}
const { s, frames } = Astro.props;
---
<Base title={s.data.title} description={s.data.blurb}>
  <div class="wrap page">
    <div class="page-head"><p class="eyebrow">Frames</p><h1 class="sig">{s.data.title}</h1><p class="lede">{s.data.blurb}</p></div>
    <SeriesTabs current={s.id} />
    <Gallery frames={frames} />
  </div>
</Base>
