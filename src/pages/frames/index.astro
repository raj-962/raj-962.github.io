---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import SeriesTabs from '../../components/SeriesTabs.astro';
const frames = (await getCollection('frames')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Frames" description="Photography by Raja Shekar: street, nature and campus.">
  <div class="wrap page">
    <div class="page-head"><p class="eyebrow">Frames</p><h1 class="sig">Light, caught</h1>
      <p class="lede">Street, nature and campus, shot around Bengaluru. Tap a photo to view it larger.</p></div>
    <SeriesTabs current="all" />
    <Gallery frames={frames} />
  </div>
</Base>
