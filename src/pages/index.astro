---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import settings from '../content/data/settings.json';
import quotes from '../content/data/quotes.json';
import { existsSync } from 'node:fs';

const frames = (await getCollection('frames')).sort((a, b) => +b.data.date - +a.data.date);
const pile = frames.slice(0, 3);
const strip = frames.slice(0, 4);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const quote = quotes[Math.floor(Date.now() / 86400000) % quotes.length];
const hasPortrait = existsSync('./public/images/portrait.jpg');
const hasResume = existsSync('./public/resumes/Raja_Shekar_Resume.pdf');
---
<Base>
  <section class="hero">
    <div class="doors">
      <a class="door eng" href="/work/" aria-label="Engineer: see my work">
        <div class="gridlines" aria-hidden="true"></div>
        <svg class="wave" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 H50 V12 H110 V48 H170 V12 H230 V48 H290 V30 H400" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span class="door-card glass">
          <span class="eyebrow">Engineer</span>
          <strong>Chips and embedded systems</strong>
          <span class="go">See my work →</span>
        </span>
      </a>
      <a class="door pho" href="/frames/" aria-label="Photographer: see my frames">
        <span class="door-card glass">
          <span class="eyebrow">Photographer</span>
          <strong>Street, nature and campus</strong>
          <span class="go">See my frames →</span>
        </span>
      </a>
    </div>

    <div class="intro">
      <p class="eyebrow">ECE · UVCE Bengaluru</p>
      <h1 class="sig">{settings.name}</h1>
      <p class="tag">{settings.tagline}</p>
    </div>

    <div class="rail">
      <aside class="quote glass" aria-label="Quote of the day">
        <p class="eyebrow">Quote of the day</p>
        <p class="q sig">“{quote.text}”</p>
        <p class="by">{quote.by}</p>
      </aside>
    </div>

    <div class="profile glass">
        {hasResume
          ? <a class="btn" href="/resumes/Raja_Shekar_Resume.pdf" download>Resume (PDF)</a>
          : <a class="btn" href="/resume/">Resume</a>}
        {hasPortrait
          ? <img class="portrait" src="/images/portrait.jpg" alt="Portrait of Raja Shekar" width="72" height="72" />
          : <span class="portrait initials sig" aria-hidden="true">RS</span>}
        <span class="status"><span class="led"></span>{settings.status.label}</span>
      </div>

    <a class="latest" href="/frames/" aria-label="Latest frames">
      {pile.map((f, i) => (
        <span class={`print p${i}`}><Image src={f.data.image} alt="" width={220} height={150} /></span>
      ))}
      <span class="lab">Latest frames</span>
    </a>
  </section>

  <section class="wrap strip">
    <div class="head"><h2>Selected work</h2><a href="/work/">All projects →</a></div>
    <div class="grid">
      {projects.map((p) => (
        <a class="glass card" href={`/work/${p.id}/`}>
          <p class="eyebrow">{p.data.area}</p><h3>{p.data.title}</h3>
          <p class="muted">{p.data.summary}</p>
          <span class="more">Read more →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap strip">
    <div class="head"><h2>Latest frames</h2><a href="/frames/">All frames →</a></div>
    <div class="thumbs">
      {strip.map((f) => (
        <a href={`/frames/${f.data.series}/`}><Image src={f.data.image} alt={f.data.alt} widths={[300, 600]} sizes="(max-width:700px) 50vw, 260px" loading="lazy" /></a>
      ))}
    </div>
  </section>

  <section class="wrap strip">
    <h2>Now</h2>
    <ul class="chips">{settings.now.map((n) => <li class="chip">{n}</li>)}</ul>
  </section>

  <section class="wrap strip">
    <div class="cta-band glass">
      <div><h2 style="margin:0">Let's talk</h2><p class="muted" style="margin:.3em 0 0">Internships, projects, or a photo walk in Bengaluru.</p></div>
      <a class="btn" href="/contact/">Get in touch</a>
    </div>
  </section>
</Base>

<style>
  .hero{position:relative;min-height:max(100svh,680px);overflow:hidden}
  .doors{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;transition:grid-template-columns .45s ease}
  .doors:has(.pho:hover),.doors:has(.pho:focus-visible){grid-template-columns:.8fr 1.2fr}
  .doors:has(.eng:hover),.doors:has(.eng:focus-visible){grid-template-columns:1.2fr .8fr}
  .door{position:relative;display:flex;align-items:flex-end;padding:0 clamp(24px,5vw,70px) clamp(70px,13vh,130px);text-decoration:none;color:var(--text);overflow:hidden}
  .eng{background:var(--eng);justify-content:flex-end}
  .pho{background:var(--pho);justify-content:flex-start}
  .gridlines{position:absolute;inset:0;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:36px 36px}
  .wave{position:absolute;left:0;right:0;bottom:0;width:100%;height:80px;color:var(--silver);opacity:.35}
  .door::after{content:"";position:absolute;inset:0;background:linear-gradient(var(--base),transparent 28%);opacity:.5;pointer-events:none}
  .door-card{min-height:116px;position:relative;z-index:2;display:flex;flex-direction:column;gap:4px;padding:18px 22px;max-width:330px;transition:transform .2s,border-color .2s}
  .door-card strong{font-size:1.2rem;line-height:1.25}
  .door-card .eyebrow{margin:0}
  .go{margin-top:6px;color:var(--accent);font-weight:600}
  .door:hover .door-card,.door:focus-visible .door-card{transform:translateY(-4px);border-color:var(--accent)}
  .intro{position:relative;z-index:3;pointer-events:none;text-align:center;padding:clamp(130px,22vh,190px) 20px 0}
  .intro .eyebrow{color:var(--text);text-shadow:0 1px 8px rgba(0,0,0,.5)}
  .intro h1{font-size:clamp(3.2rem,10vw,7.2rem);margin:0;text-shadow:0 4px 30px rgba(0,0,0,.35)}
  .intro .tag{font-size:clamp(1.05rem,2vw,1.3rem);margin:.4rem 0 0;text-shadow:0 1px 12px rgba(0,0,0,.45)}
  :global([data-theme="light"]) .intro .eyebrow,:global([data-theme="light"]) .intro h1,:global([data-theme="light"]) .intro .tag{text-shadow:none}
  .rail{position:absolute;z-index:4;top:96px;left:20px;display:flex;flex-direction:column;gap:14px;width:290px}
  .quote{padding:16px 18px}
  .quote .eyebrow{margin-bottom:6px}
  .quote .q{font-size:1.25rem;line-height:1.3;margin:0 0 6px}
  .quote .by{margin:0;font-size:.8rem;color:var(--muted)}
  .profile{position:absolute;z-index:4;top:96px;right:20px;width:200px;padding:16px;display:flex;flex-direction:column;align-items:center;gap:12px}
  .portrait{width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid var(--edge);box-shadow:var(--shadow)}
  .initials{display:grid;place-items:center;font-size:1.9rem;background:linear-gradient(145deg,var(--accent),color-mix(in srgb,var(--accent) 40%,#000));color:var(--accent-ink)}
  .status{display:flex;align-items:center;gap:8px;font-size:.88rem;color:var(--muted)}
  .led{width:9px;height:9px;border-radius:50%;background:var(--led);box-shadow:0 0 8px var(--led)}
  .latest{position:absolute;z-index:4;right:30px;bottom:30px;width:230px;height:180px;text-decoration:none}
  .print{position:absolute;display:block;padding:7px 7px 22px;background:#f6f3ec;box-shadow:0 10px 24px rgba(0,0,0,.4);transition:transform .25s}
  .print :global(img){display:block;width:190px;height:auto}
  .p0{right:0;bottom:0;transform:rotate(4deg);z-index:3}
  .p1{right:28px;bottom:12px;transform:rotate(-5deg);z-index:2}
  .p2{right:6px;bottom:22px;transform:rotate(9deg);z-index:1}
  .latest:hover .p0{transform:rotate(1deg) translateY(-6px)}
  .lab{position:absolute;z-index:5;left:0;top:-24px;font-size:.8rem;font-weight:600;color:var(--text);background:var(--glass);border:1px solid var(--edge);padding:.2rem .7rem;border-radius:999px;backdrop-filter:blur(10px)}
  .strip{padding-top:72px}
  .head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:18px}
  .head h2{margin:0}
  .head a{color:var(--accent);font-weight:600;text-decoration:none;white-space:nowrap}
  .thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .thumbs a{display:block}
  .thumbs :global(img){display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
  .cta-band{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;padding:28px 30px}
  @media (max-width:1180px){.latest{display:none}}
  @media (max-width:900px){
    .hero{min-height:0;display:flex;flex-direction:column;padding:0 0 10px}
    .intro{order:1;padding-top:96px;padding-bottom:20px}
    .intro h1{text-shadow:none}
    .rail{order:2;position:relative;top:auto;left:auto;width:auto;margin:0 20px 14px}
    .profile{order:2;position:relative;top:auto;right:auto;width:auto;margin:0 20px 18px;flex-direction:row;justify-content:space-between;flex-wrap:wrap}
    .doors{order:3;position:relative;inset:auto;display:flex;flex-direction:column;gap:14px;padding:0 20px}
    .doors:has(.pho:hover),.doors:has(.eng:hover){grid-template-columns:none}
    .door{min-height:190px;padding:20px;border-radius:var(--radius);justify-content:flex-start;align-items:flex-end}
    .door-card{max-width:none;width:100%}
    .thumbs{grid-template-columns:repeat(2,1fr)}
  }
</style>
