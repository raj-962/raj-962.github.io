---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('notes', (n) => !n.data.draft)).map((n) => ({ params: { id: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Base title={n.data.title} description={n.data.summary}>
  <article class="wrap page prose">
    <p class="eyebrow"><a href="/notes/">← Notes</a> · {n.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <h1 class="sig">{n.data.title}</h1>
    <Content />
  </article>
</Base>
