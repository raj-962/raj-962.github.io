---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', (n) => !n.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Notes" description="Writing on chip design, photography and chess.">
  <div class="wrap page">
    <p class="eyebrow">Notes</p><h1 class="sig">Things I am figuring out</h1>
    <div class="grid" style="margin-top:30px">
      {notes.map((n) => (
        <a class="glass card" href={`/notes/${n.id}/`}>
          <p class="eyebrow">{fmt(n.data.date)}</p><h3>{n.data.title}</h3><p class="muted">{n.data.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
